<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="300.0" prefWidth="438.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sojourners.chess.controller.BookSettingController">
   <bottom>
      <HBox alignment="TOP_RIGHT" minHeight="-Infinity" minWidth="-Infinity" prefHeight="60.0" prefWidth="437.0" BorderPane.alignment="TOP_CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#okButtonClick" prefHeight="27.0" prefWidth="72.0" text="%booksettingdialog.ok">
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#cancelButtonClick" prefHeight="27.0" prefWidth="72.0" text="%booksettingdialog.cancel">
               <HBox.margin>
                  <Insets right="50.0" />
               </HBox.margin></Button>
         </children>
      </HBox>
   </bottom>
   <center>
  <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="240.0" prefWidth="437.0" BorderPane.alignment="CENTER">
         <children>
            <CheckBox fx:id="useCloudBook" layoutX="50.0" layoutY="40.0" mnemonicParsing="false" text="%booksettingdialog.enabletimeout" />
            <TextField fx:id="cloudBookTimeout" layoutX="183.0" layoutY="35.0" prefHeight="27.0" prefWidth="72.0" />
            <Label layoutX="260.0" layoutY="41.0" text="%booksettingdialog.milisecond" />
            <CheckBox fx:id="onlyCloudFinalPhase" layoutX="50.0" layoutY="70.0" mnemonicParsing="false" text="%booksettingdialog.engmetable" />
            <CheckBox fx:id="localBookFirst" layoutX="50.0" layoutY="107.0" mnemonicParsing="false" text="%booksettingdialog.localbook" />
            <Button layoutX="177.0" layoutY="103.0" mnemonicParsing="false" onAction="#localBookManageButtonClick" text="%booksettingdialog.localbookmanage" />
            <RadioButton fx:id="bestScoreRadioButton" layoutX="49.0" layoutY="147.0" mnemonicParsing="false" text="%booksettingdialog.hightscore" />
            <RadioButton fx:id="bestWinrateRadioButton" layoutX="132.0" layoutY="147.0" mnemonicParsing="false" text="%booksettingdialog.hightwin" />
            <RadioButton fx:id="positiveRandomRadioButton" layoutX="231.0" layoutY="147.0" mnemonicParsing="false" text="%booksettingdialog.random" />
            <RadioButton fx:id="fullRandomRadioButton" layoutX="331.0" layoutY="147.0" mnemonicParsing="false" text="%booksettingdialog.comprandom" />
            <Label layoutX="51.0" layoutY="189.0" text="%booksettingdialog.outbook" />
            <TextField fx:id="offManualSteps" layoutX="107.0" layoutY="184.0" prefHeight="27.0" prefWidth="70.0" />
            <Label layoutX="181.0" layoutY="189.0" text="%booksettingdialog.move" />
         </children>
      </AnchorPane>
   </center>
</BorderPane>
